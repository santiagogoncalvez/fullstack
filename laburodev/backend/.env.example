# Copiar a .env y completar. En local puede quedar el default.
# URL del frontend habilitada en CORS (varias, separadas por coma).
FRONTEND_URL=http://localhost:5173
# Puerto de la API.
PORT=3000
# API Key de Google Generative AI (Gemini). Obtener en https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelo de IA a usar (default: gemini-3.5-flash-lite)
MODEL_AI=gemini-3.5-flash-lite

# Base de datos Turso (libSQL) / SQLite local
# Si se dejan vacías, el backend utiliza automáticamente la base de datos local (file:local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=