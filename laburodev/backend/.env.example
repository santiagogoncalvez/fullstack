# Copiar a .env y completar. En local puede quedar el default.
# URL del frontend habilitada en CORS (varias, separadas por coma).
FRONTEND_URL=http://localhost:5173
# Puerto de la API.
PORT=3000
# API Key de Google Generative AI (Gemini). Obtener en https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelo de IA a usar (default: gemini-2.0-flash-lite)
MODEL_AI=gemini-2.0-flash-lite